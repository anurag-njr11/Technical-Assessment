# Copy to .env.local and fill in. Never commit .env.local.
VITE_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOYMENT=
CONVEX_DEPLOY_KEY=
SITE_URL=http://localhost:3000

# Convex deployment env vars (set with `npx convex env set NAME value`, not here):
#   JWT_PRIVATE_KEY, JWKS, SITE_URL (Convex Auth; `npx @convex-dev/auth` sets them)
#   Macaly credits: MACALY_API_TOKEN, MACALY_BASE_URL, MACALY_CHAT_ID (take precedence over LLM_*)
#   Optional: LLM_API_KEY, LLM_BASE_URL, ASSISTANT_MODEL, RESEND_API_KEY, EMAIL_FROM, WORKSPACE_OWNER_EMAIL, SUBMISSIONS_PER_HOUR, STARTS_PER_HOUR, JUDGE_PANEL_JSON
